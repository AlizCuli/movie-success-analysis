# Python
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Virtual environments and IDEs
.venv/
venv/
.idea/
.vscode/

# Local configuration and operating-system files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Temporary downloads and logs
*.part
*.tmp
*.log

# Row-level data remains local and is not distributed through the public repository.
# README files and .gitkeep placeholders remain tracked to document the structure.
data/raw/*
!data/raw/.gitkeep
data/external/*
!data/external/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Bỏ qua model thử nghiệm; chỉ cho phép gói XGBoost chính thức.
models/*.joblib
models/*.cbm
models/*.json
models/*.db
models/*.log
models/*.pid
!models/xgboost_pre_release_operational_bundle.joblib
!models/xgboost_pre_release_operational_model.json
!models/xgboost_pre_release_operational_manifest.json

# Row-level evaluation artifacts remain local. Public reports only contain
# aggregate metrics, tables and figures.
reports/tables/*_oof_predictions.csv
reports/tables/*_outer_fold_assignments.csv
reports/tables/xgboost_error_analysis.csv
reports/predictions/
